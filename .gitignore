# Base: https://github.com/github/gitignore/blob/main/Unity.gitignore

# === Unity (Audio-Only-Shooting-Range/) ===

Audio-Only-Shooting-Range/.utmp/
Audio-Only-Shooting-Range/[Ll]ibrary/
Audio-Only-Shooting-Range/[Tt]emp/
Audio-Only-Shooting-Range/[Oo]bj/
Audio-Only-Shooting-Range/[Bb]uild/
Audio-Only-Shooting-Range/[Bb]uilds/
Audio-Only-Shooting-Range/[Ll]ogs/
Audio-Only-Shooting-Range/[Uu]ser[Ss]ettings/
Audio-Only-Shooting-Range/*.log

Audio-Only-Shooting-Range/*.blend1
Audio-Only-Shooting-Range/*.blend1.meta

Audio-Only-Shooting-Range/[Mm]emoryCaptures/
Audio-Only-Shooting-Range/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
Audio-Only-Shooting-Range/[Aa]ssets/Plugins/Editor/JetBrains*
Audio-Only-Shooting-Range/*.DotSettings.user

Audio-Only-Shooting-Range/.vs/
Audio-Only-Shooting-Range/.gradle/

Audio-Only-Shooting-Range/ExportedObj/
Audio-Only-Shooting-Range/.consulo/
Audio-Only-Shooting-Range/*.csproj
Audio-Only-Shooting-Range/*.unityproj
Audio-Only-Shooting-Range/*.sln
Audio-Only-Shooting-Range/*.slnx
Audio-Only-Shooting-Range/*.suo
Audio-Only-Shooting-Range/*.tmp
Audio-Only-Shooting-Range/*.user
Audio-Only-Shooting-Range/*.userprefs
Audio-Only-Shooting-Range/*.pidb
Audio-Only-Shooting-Range/*.booproj
Audio-Only-Shooting-Range/*.svd
Audio-Only-Shooting-Range/*.pdb
Audio-Only-Shooting-Range/*.mdb
Audio-Only-Shooting-Range/*.opendb
Audio-Only-Shooting-Range/*.VC.db

# Unity3D generated meta files
Audio-Only-Shooting-Range/*.pidb.meta
Audio-Only-Shooting-Range/*.pdb.meta
Audio-Only-Shooting-Range/*.mdb.meta

Audio-Only-Shooting-Range/sysinfo.txt
Audio-Only-Shooting-Range/mono_crash.*

# Builds
Audio-Only-Shooting-Range/*.apk
Audio-Only-Shooting-Range/*.aab
Audio-Only-Shooting-Range/*.unitypackage
Audio-Only-Shooting-Range/*.unitypackage.meta
Audio-Only-Shooting-Range/*.app

Audio-Only-Shooting-Range/crashlytics-build.properties
Audio-Only-Shooting-Range/InitTestScene*.unity*

# Addressables
Audio-Only-Shooting-Range/ServerData
Audio-Only-Shooting-Range/[Aa]ssets/StreamingAssets/aa*
Audio-Only-Shooting-Range/[Aa]ssets/AddressableAssetsData/link.xml*
Audio-Only-Shooting-Range/[Aa]ssets/Addressables_Temp*
Audio-Only-Shooting-Range/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
Audio-Only-Shooting-Range/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Audio-Only-Shooting-Range/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Audio-Only-Shooting-Range/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Audio-Only-Shooting-Range/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

Audio-Only-Shooting-Range/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
Audio-Only-Shooting-Range/[Aa]ssets/[Ss]ceneDependencyCache*

# === FMOD Unity plugin (Audio-Only-Shooting-Range/) ===

Audio-Only-Shooting-Range/**/FMODStudioCache.asset
Audio-Only-Shooting-Range/[Aa]ssets/Plugins/FMOD/Cache/*

# Never ignore the FMOD libs / editor icons
!Audio-Only-Shooting-Range/[Aa]ssets/Plugins/FMOD/**/lib/*
!Audio-Only-Shooting-Range/[Aa]ssets/Gizmos/FMOD/*
!Audio-Only-Shooting-Range/[Aa]ssets/Editor Default Resources/FMOD/*

Audio-Only-Shooting-Range/[Aa]ssets/StreamingAssets/**/*.bank
Audio-Only-Shooting-Range/[Aa]ssets/StreamingAssets/**/*.bank.meta

# === FMOD Studio project (FMOD/<project>/) ===

FMOD/**/.cache/
FMOD/**/.user/
FMOD/**/*.user
FMOD/**/.unsaved/
FMOD/**/.restore/
FMOD/**/Build/
FMOD/**/Metadata/Workspace.xml

